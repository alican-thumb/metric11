# Clerk (Vercel Marketplace entegrasyonu ile otomatik enjekte edilir)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon (Vercel Marketplace entegrasyonu ile otomatik enjekte edilir)
DATABASE_URL=

# Vercel Cron doğrulama sırrı (vercel env add CRON_SECRET ile elle eklenmeli)
CRON_SECRET=

# metric11 ana sitesinin verileri okuduğu adres (varsayılan: https://metric11.com)
METRIC11_BASE_URL=https://metric11.com

# Microfrontends: microfrontends.json repo kökünde (bu projenin rootDirectory'sinin
# BİR ÜSTÜNDE), Vercel proje ayarlarına elle eklenmeli.
VC_MICROFRONTENDS_CONFIG_FILE_NAME=../microfrontends.json
